# ---- macOS ----
.DS_Store

# ---- Xcode ----
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3

# ---- Swift Package Manager ----
.build/
.swiftpm/
Package.resolved.local

# Locally built binary SDK artifacts consumed by the host apps.
artifacts/
*.xcframework/
*.xcframework.zip

# The whole SDK packaging workspace, not just the finished zip. The per-architecture
# .dylib/.a slices and the skip export trees that feed -create-xcframework live here too,
# and ignoring only the final artifact leaves tens of megabytes of intermediates tracked.
**/sdks/**/out/
*.dylib
*-project.zip

# ---- Android / Gradle ----
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.aar
!**/libs/*.aar
release/

# ---- Kotlin ----
.kotlin/

# ---- Node / React Native ----
node_modules/
npm-debug.log*
yarn-error.log*
.metro-health-check*
# Metro and Hermes output. Rebuilt by 03-sdk-rn/sdks/core/build-xcframework.sh.
*.jsbundle
*.hbc
# No leading path component: a pattern containing a slash is anchored to this file's
# directory, so "ios/Pods/" would only ever match a Pods folder at the repo root.
Pods/
.expo/
.xcode.env.local

# ---- Rust ----
target/
**/*.rs.bk
Cargo.lock.local

# UniFFI output and the native libraries copied into the hosts. Regenerated by
# 02-core-rust/sdks/build-android.sh and build-apple.sh.
02-core-rust/android/app/src/main/jniLibs/
02-core-rust/android/app/src/main/java/uniffi/

# The generated Swift and the C header land inside the SPM packages. Only each package's
# hand-written shim.c is committed; the xcframeworks are covered by the **/sdks/**/out/ rule.
02-core-rust/sdks/core/Sources/FightCore/
02-core-rust/sdks/core/Sources/fightcoreFFI/include/
02-core-rust/sdks/slip/Sources/FightSlip/
02-core-rust/sdks/slip/Sources/fightslipFFI/include/
02-core-rust/sdks/events/Sources/FightEvents/
02-core-rust/sdks/events/Sources/fighteventsFFI/include/

# ---- Skip ----
# Only the transpiler's scratch dir. A module's Sources/<Target>/Skip/skip.yml is
# hand-written configuration without which skipstone refuses to process the module,
# and an ignore rule of `Skip/` silently kept it out of every clone.
.skip/

# ---- IDE ----
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.cursor/

# ---- Measurement output ----
# Receipts are regenerated by measure.yml; only the committed snapshot under
# talk/assets is kept, so that a stale local run never ends up on a slide.
tools/out/
*.receipt.md

# Staging directory for tools/ci-local.sh release-sdk checksum checks.
release-staging/

# Wikimedia Commons API cache for tools/fetch-real-art.py (regenerated locally).
tools/.commons-cache.json

# Records which feature set the last SDK build bundled, so the Podfile can catch a mismatch.
03-sdk-rn/sdks/core/ios/.fightdeck-features

# Metro's text bundle, kept out of Resources/ so the podspec does not ship it next to the
# Hermes bytecode that actually gets loaded.
03-sdk-rn/sdks/core/ios/.jsbundle-staging/

# JVM heap dumps from Gradle OOMs
*.hprof
