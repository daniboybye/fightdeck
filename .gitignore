# ---- macOS ----
.DS_Store

# ---- Xcode ----
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3

# ---- Swift Package Manager ----
.build/
.swiftpm/
Package.resolved.local

# Locally built binary artifacts consumed when FIGHTDECK_LOCAL_SDK=1.
# The committed Package.swift points at pinned GitHub Releases; these are the dev-loop copies.
artifacts/
*.xcframework/
*.xcframework.zip

# The whole SDK packaging workspace, not just the finished zip. The per-architecture
# .dylib/.a slices and the skip export trees that feed -create-xcframework live here too,
# and ignoring only the final artifact leaves tens of megabytes of intermediates tracked.
**/sdks/**/out/
*.dylib
*-project.zip

# ---- Android / Gradle ----
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.aar
!**/libs/*.aar
release/

# ---- Kotlin ----
.kotlin/

# ---- Node / React Native ----
node_modules/
npm-debug.log*
yarn-error.log*
.metro-health-check*
# Metro and Hermes output. Rebuilt by 03-sdk-rn/sdks/core/build-xcframework.sh.
*.jsbundle
*.hbc
# No leading path component: a pattern containing a slash is anchored to this file's
# directory, so "ios/Pods/" would only ever match a Pods folder at the repo root.
Pods/
.expo/
.xcode.env.local

# ---- Rust ----
target/
**/*.rs.bk
Cargo.lock.local

# UniFFI output and the native libraries copied into the hosts. Regenerated by
# 02-core-rust/sdks/core/build-aar.sh and build-xcframework.sh.
02-core-rust/android/app/src/main/jniLibs/
02-core-rust/android/app/src/main/java/uniffi/
02-core-rust/ios/FightDeck/Generated/

# ---- Skip ----
# Only the transpiler's scratch dir. A module's Sources/<Target>/Skip/skip.yml is
# hand-written configuration without which skipstone refuses to process the module,
# and an ignore rule of `Skip/` silently kept it out of every clone.
.skip/

# ---- IDE ----
.idea/
*.iml
.vscode/
!.vscode/extensions.json

# ---- Measurement output ----
# Receipts are regenerated by measure.yml; only the committed snapshot under
# talk/assets is kept, so that a stale local run never ends up on a slide.
tools/out/
*.receipt.md

# JVM heap dumps from Gradle OOMs
*.hprof
