{
  "javaPackage": "com.fightdeck.fightcore",
  "mode": "jni",
  // Android's runtime is JDK 17; the jextract default of 22 emits Java the AGP
  // toolchain refuses to compile.
  "javaSourceLevel": 17,
  // build-aar.sh installs the product as libfightcore.so, not libFightCoreShared.so,
  // and the generated static initialiser calls System.loadLibrary with this name.
  "nativeLibraryName": "fightcore",
  // Kotlin call sites should not have to thread a SwiftArena through the view model;
  // the global arena frees Swift objects when the JVM collects their Java wrappers.
  "memoryManagementMode": "allowGlobalAutomatic",
  "logLevel": "info"
}
