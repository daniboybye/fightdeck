namespace fightcore {
};

dictionary BoutRecord {
    string id;
    u32 order;
    string segment;
    string weight_class;
    boolean title_fight;
    u32 scheduled_rounds;
    string red_fighter_id;
    string red_fighter_name;
    string red_odds;
    string blue_fighter_id;
    string blue_fighter_name;
    string blue_odds;
    string winner_id;
    string winner_name;
    string method;
    string detail;
    u32 end_round;
    string end_time;
};

dictionary EventRecord {
    string id;
    string name;
    string date;
    string venue;
    string city;
    string poster_path;
    sequence<BoutRecord> bouts;
};

dictionary FighterRecord {
    string id;
    string name;
    string? nickname;
    string? country;
    u32? height_cm;
    u32? reach_in;
    string? stance;
    string record_display;
    string portrait_path;
};

