# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '26.0'
prepare_react_native_project!

$RN_APP_ROOT = File.expand_path('..', __dir__)
$FIGHTDECK_USE_LOCAL_SDK = ENV['FIGHTDECK_LOCAL_SDK'] == '1'
$FIGHTDECK_RELEASE_VENDOR = File.expand_path('../../tools/out/release/rn/ios-vendor', __dir__)
$FIGHTDECK_FEATURES = ENV.fetch('FIGHTDECK_FEATURES', 'all')

# The demo app links all three features. The four harness targets exist only so
# tools/measure-second-feature.sh can weigh a runtime with no feature screens against the
# same runtime with one, two and three — see ios/Harness/Shared/HarnessApp.swift.
#
# Each target's pod set is fixed by its name rather than by an environment variable, which
# is what lets the app's Swift compile without a single #if: a source file is only ever
# built by a target that links the SDKs it imports.
FIGHTDECK_TARGET_FEATURES = {
  'FightDeck' => %i[deposit betslip fighter],
  'FightDeckHarnessRuntime' => [],
  'FightDeckHarnessDeposit' => %i[deposit],
  'FightDeckHarnessBoth' => %i[deposit betslip],
  'FightDeckHarnessAll' => %i[deposit betslip fighter],
}.freeze

def fightdeck_feature_pods(features)
  if $FIGHTDECK_USE_LOCAL_SDK
    pod 'DepositSDK', :path => '../sdks/deposit/ios' if features.include?(:deposit)
    pod 'BetslipSDK', :path => '../sdks/betslip/ios' if features.include?(:betslip)
    pod 'FighterSDK', :path => '../sdks/fighter/ios' if features.include?(:fighter)
  else
    pod 'DepositSDKVendor', :path => $FIGHTDECK_RELEASE_VENDOR if features.include?(:deposit)
    pod 'BetslipSDKVendor', :path => $FIGHTDECK_RELEASE_VENDOR if features.include?(:betslip)
    pod 'FighterSDKVendor', :path => $FIGHTDECK_RELEASE_VENDOR if features.include?(:fighter)
  end
end

# React Native, Hermes and the runtime pod are shared by every target; only the feature pods
# differ. use_react_native! has to be inside the abstract target so all four inherit it.
abstract_target 'FightDeckHosts' do
  if $FIGHTDECK_USE_LOCAL_SDK
    config = use_native_modules!

    use_react_native!(
      :path => config[:reactNativePath],
      :app_path => $RN_APP_ROOT
    )

    pod 'FightDeckRNRuntime', :path => '../sdks/core/ios'
  else
    unless File.directory?($FIGHTDECK_RELEASE_VENDOR)
      raise "Pinned RN iOS vendor missing at #{$FIGHTDECK_RELEASE_VENDOR}. Run tools/release-sdk-local.sh rn"
    end

    pod 'FightDeckRNVendor', :path => $FIGHTDECK_RELEASE_VENDOR
  end

  FIGHTDECK_TARGET_FEATURES.each do |target_name, features|
    target target_name do
      fightdeck_feature_pods(features)
    end
  end

  post_install do |installer|
    if $FIGHTDECK_USE_LOCAL_SDK
      react_native_post_install(
        installer,
        config[:reactNativePath],
        :mac_catalyst_enabled => false
      )
    end

    # The JS bundle is baked into the runtime pod's resources, so which feature screens
    # exist in JavaScript is decided when the SDK is built, not here. A deposit-only harness
    # linked against an all-surfaces bundle runs fine and reports a size that means nothing,
    # which is why the stage being measured has to agree with the bundle on disk.
    stamp = File.join(__dir__, '..', 'sdks', 'core', 'ios', '.fightdeck-features')
    if File.exist?(stamp)
      built = File.read(stamp).strip
      unless built == $FIGHTDECK_FEATURES
        raise "SDK bundle was built for '#{built}' but FIGHTDECK_FEATURES is '#{$FIGHTDECK_FEATURES}'. " \
              "Rebuild it: FIGHTDECK_FEATURES=#{$FIGHTDECK_FEATURES} ./sdks/core/build-jsbundle.sh"
      end
    end
  end
end
