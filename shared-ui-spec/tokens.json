{
  "$schema": "https://tr.designtokens.org/format/2025.10/schema.json",
  "$description": "fightdeck design tokens. DTCG 2025.10 — the first stable version of the format, published October 2025. This file is the single source for every colour, spacing step and type ramp across all five approaches, in both SwiftUI and Compose. It is also the talk's own argument applied to itself: when a design system has to exist on three platforms, the thing worth sharing is the token, not the component.",

  "color": {
    "$type": "color",
    "background": {
      "$value": { "colorSpace": "srgb", "components": [0.043, 0.055, 0.078], "alpha": 1, "hex": "#0B0E14" },
      "$description": "App background. Near-black with a blue cast so surfaces read as lifted."
    },
    "surface": {
      "$value": { "colorSpace": "srgb", "components": [0.078, 0.098, 0.133], "alpha": 1, "hex": "#141922" },
      "$description": "Cards and list rows."
    },
    "surfaceElevated": {
      "$value": { "colorSpace": "srgb", "components": [0.110, 0.133, 0.188], "alpha": 1, "hex": "#1C2230" },
      "$description": "Sheets, the bet slip, anything above a card."
    },
    "border": {
      "$value": { "colorSpace": "srgb", "components": [0.137, 0.165, 0.220], "alpha": 1, "hex": "#232A38" }
    },
    "textPrimary": {
      "$value": { "colorSpace": "srgb", "components": [0.961, 0.969, 0.980], "alpha": 1, "hex": "#F5F7FA" }
    },
    "textSecondary": {
      "$value": { "colorSpace": "srgb", "components": [0.604, 0.647, 0.722], "alpha": 1, "hex": "#9AA5B8" }
    },
    "accent": {
      "$value": { "colorSpace": "srgb", "components": [0.910, 0.702, 0.235], "alpha": 1, "hex": "#E8B33C" },
      "$description": "Odds buttons and the primary call to action. Nothing else uses it, so the eye always knows where the money is."
    },
    "onAccent": {
      "$value": { "colorSpace": "srgb", "components": [0.043, 0.055, 0.078], "alpha": 1, "hex": "#0B0E14" }
    },
    "positive": {
      "$value": { "colorSpace": "srgb", "components": [0.239, 0.839, 0.549], "alpha": 1, "hex": "#3DD68C" },
      "$description": "Winning leg, settled return, odds drifting in."
    },
    "negative": {
      "$value": { "colorSpace": "srgb", "components": [0.949, 0.329, 0.357], "alpha": 1, "hex": "#F2545B" },
      "$description": "Losing leg, validation error, odds shortening."
    },
    "cornerRed": {
      "$value": { "colorSpace": "srgb", "components": [0.851, 0.290, 0.290], "alpha": 1, "hex": "#D94A4A" }
    },
    "cornerBlue": {
      "$value": { "colorSpace": "srgb", "components": [0.290, 0.498, 0.851], "alpha": 1, "hex": "#4A7FD9" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "A 4pt grid. Anything not on the grid is a bug.",
    "xs":  { "$value": { "value": 4,  "unit": "px" } },
    "sm":  { "$value": { "value": 8,  "unit": "px" } },
    "md":  { "$value": { "value": 12, "unit": "px" } },
    "lg":  { "$value": { "value": 16, "unit": "px" } },
    "xl":  { "$value": { "value": 24, "unit": "px" } },
    "xxl": { "$value": { "value": 32, "unit": "px" } }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 8,   "unit": "px" } },
    "md":   { "$value": { "value": 12,  "unit": "px" } },
    "lg":   { "$value": { "value": 16,  "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },

  "fontSize": {
    "$type": "dimension",
    "caption":  { "$value": { "value": 12, "unit": "px" } },
    "body":     { "$value": { "value": 15, "unit": "px" } },
    "callout":  { "$value": { "value": 17, "unit": "px" } },
    "title":    { "$value": { "value": 22, "unit": "px" } },
    "headline": { "$value": { "value": 28, "unit": "px" } },
    "display":  { "$value": { "value": 34, "unit": "px" } }
  },

  "fontWeight": {
    "$type": "fontWeight",
    "regular":  { "$value": 400 },
    "medium":   { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold":     { "$value": 700 }
  },

  "duration": {
    "$type": "duration",
    "$description": "Motion. iOS 26 and Material 3 Expressive both favour spring physics over fixed curves; these are the fallback durations for the cases where a spring is not appropriate.",
    "instant": { "$value": { "value": 120, "unit": "ms" } },
    "quick":   { "$value": { "value": 220, "unit": "ms" } },
    "settled": { "$value": { "value": 360, "unit": "ms" } }
  },

  "component": {
    "oddsButton": {
      "background":      { "$type": "color",     "$value": "{color.surfaceElevated}" },
      "backgroundActive":{ "$type": "color",     "$value": "{color.accent}" },
      "label":           { "$type": "color",     "$value": "{color.accent}" },
      "labelActive":     { "$type": "color",     "$value": "{color.onAccent}" },
      "radius":          { "$type": "dimension", "$value": "{radius.sm}" },
      "minHeight":       { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
      "$description": "44pt minimum is the Apple hit target and comfortably clears the Material 48dp guidance once padding is included."
    },
    "card": {
      "background": { "$type": "color",     "$value": "{color.surface}" },
      "border":     { "$type": "color",     "$value": "{color.border}" },
      "radius":     { "$type": "dimension", "$value": "{radius.lg}" },
      "padding":    { "$type": "dimension", "$value": "{spacing.lg}" }
    },
    "primaryButton": {
      "background": { "$type": "color",     "$value": "{color.accent}" },
      "label":      { "$type": "color",     "$value": "{color.onAccent}" },
      "radius":     { "$type": "dimension", "$value": "{radius.md}" },
      "minHeight":  { "$type": "dimension", "$value": { "value": 52, "unit": "px" } }
    }
  }
}
